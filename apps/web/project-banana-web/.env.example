# Copy this file to `.env.local` for local development.
# Match these values to the backend Convex deployment you want this app to use.

# Required
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
VITE_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional support/contact overrides
# VITE_REPORT_ISSUE_FORM_URL=https://forms.gle/your-form-id
# VITE_CHAT_SUPPORT_URL=https://wa.me/60123456789
# VITE_CONTACT_EMAIL=support@example.com

# Optional admin/campaign overrides
# VITE_ADMIN_CODE=replace-with-admin-access-code
# VITE_LAUNCH_FEE=300
# VITE_TOPUP_MIN_AMOUNT=100

# Optional Stripe price overrides
# Uncomment only for plans you actively use.
# VITE_STRIPE_PRICE_PAYG_MONTHLY=price_your_payg_monthly_id
# VITE_STRIPE_PRICE_PAYG_ANNUAL=price_your_payg_annual_id
# VITE_STRIPE_PRICE_STARTER_MONTHLY=price_your_starter_monthly_id
# VITE_STRIPE_PRICE_STARTER_ANNUAL=price_your_starter_annual_id
# VITE_STRIPE_PRICE_GROWTH_MONTHLY=price_your_growth_monthly_id
# VITE_STRIPE_PRICE_GROWTH_ANNUAL=price_your_growth_annual_id
# VITE_STRIPE_PRICE_UNLIMITED_MONTHLY=price_your_unlimited_monthly_id
# VITE_STRIPE_PRICE_UNLIMITED_ANNUAL=price_your_unlimited_annual_id
